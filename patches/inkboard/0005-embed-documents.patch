+#[test]
+fn insert_embed_adds_a_card_with_the_defaults() {
+    let (mut t, host) = hosted(FIXTURE, false);
+    let before = t.objects().len();
+    let centre = t.app().view_center();
+    let card = t.app().insert_embed(ITEM2, "Meeting notes", None, None, None).expect("a card");
+    assert_eq!(t.app().sel, std::slice::from_ref(&card));
+    let o = t.app().ed.page().get(&card).cloned().unwrap();
+    let json = serde_json::to_value(&o).unwrap();
+    let frame = o.frame().unwrap();
+    assert!((frame.center().x - centre.x).abs() < 1e-6 && (frame.center().y - centre.y).abs() < 1e-6, "{frame:?} for {centre:?}");
+    let expected = serde_json::json!({
+        "id": card.as_str(),
+        "kind": {
+            "type": "box", "geom": "rect", "frame": { "x": frame.x, "y": frame.y, "w": 480.0, "h": 360.0 },
+            "label": { "text": [{ "text": "Meeting notes", "bold": true, "color": "#1d2430" }], "family": "sans", "size": 24.0, "align": "center" },
+            "embed": { "item": ITEM2 }
+        },
+        "style": { "stroke": "#c4cad4", "fill": "#ffffff", "width": 1.0, "dash": "solid", "opacity": 1.0, "roundness": 0.04_f32, "shadow": true },
+        "layer": "main"
+    });
+    assert_eq!(json, expected);
+    assert_eq!(t.objects().len(), before + 1);
+    t.h.step();
+    assert!(host.others().iter().any(|h| matches!(h, Heard::Changed(_))), "an edit like any other");
