+
+/// `embed` as written by any program: an object with a string `item` is kept (its other fields are not), anything else is `None`.
+fn lenient_embed<'de, D: serde::Deserializer<'de>>(d: D) -> Result<Option<Embed>, D::Error> {
+    // a JSON value never fails to deserialize from well-formed JSON, so a malformed `embed` cannot make the board unreadable
+    Ok(match serde_json::Value::deserialize(d)? {
+        serde_json::Value::Object(mut fields) => match fields.remove("item") {
+            Some(serde_json::Value::String(item)) => Some(Embed { item }),
+            _ => None,
+        },
+        _ => None,
+    })
 }
 
