+    let (mut t, host) = hosted(FIXTURE, false);
+    let rev = t.app().ed.revision();
+    let p = t.at(-280.0, 0.0);
+    double_click(&mut t, p);
+    let heard = host.others();
+    let opens: Vec<&Heard> = heard.iter().filter(|h| matches!(h, Heard::Open(..))).collect();
+    assert_eq!(opens.len(), 1, "{heard:?}");
+    let Heard::Open(card, item, Some(point)) = opens[0] else { panic!("{heard:?}") };
+    assert_eq!((card.as_str(), item.as_str()), ("embedcard1", ITEM1));
+    assert!(point.distance(p) < 1.0, "{point:?} for a double-click at {p:?}");
+    assert!(t.app().editing.is_none(), "no label editing");
+    assert_eq!(t.app().sel, [id("embedcard1")]);
+    assert_eq!(t.app().ed.revision(), rev);
+    // Enter and the menu ("Edit text") reach start_editing without a point
+    t.key(Key::Enter);
+    assert_eq!(host.others(), [Heard::Open(id("embedcard1"), ITEM1.into(), None)]);
+    t.app().start_editing(&id("embedcard2"), None);
+    assert_eq!(host.others(), [Heard::Open(id("embedcard2"), ITEM2.into(), None)]);
+    assert!(t.app().editing.is_none());
+    // the plain box still edits its label
+    let p = t.at(0.0, 280.0);
+    double_click(&mut t, p);
+    assert_eq!(t.app().editing.as_ref().map(|e| e.id.clone()), Some(id("embedplain")));
+    assert!(!host.others().iter().any(|h| matches!(h, Heard::Open(..))));
