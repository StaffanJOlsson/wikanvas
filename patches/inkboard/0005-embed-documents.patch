+#[test]
+fn embed_layout_of_the_fixture() {
+    let (mut t, host) = hosted(FIXTURE, false);
+    t.app().request_embed_layout();
+    t.h.step();
+    let layouts = host.layouts();
+    assert_eq!(layouts.len(), 1, "one report for the request");
+    let l = &layouts[0];
+    assert_eq!(l.page, id("embedtest1"));
+    let ids: Vec<&str> = l.cards.iter().map(|c| c.id.as_str()).collect();
+    assert_eq!(ids, ["embedcard1", "embedcard2"], "the plain box is left out");
+    assert_eq!(l.cards[0].item, ITEM1);
+    assert_eq!(l.cards[1].label, "Second page");
+    assert_eq!(l.cards[0].frame, Frame::new(-520.0, -200.0, 480.0, 360.0));
+    assert!(!l.cards[0].selected && !l.cards[0].locked);
+    assert_eq!(l.items, [ITEM1, ITEM2]);
+    assert_eq!(l.editing, None);
+    // screen = origin + world × zoom: the canvas origin plus the view
+    let canvas = t.app().canvas_rect;
+    assert_eq!(l.canvas, canvas);
+    assert!((l.zoom - 1.0).abs() < 1e-6);
+    assert!((l.origin.x - (canvas.min.x + 600.0)).abs() < 1e-3 && (l.origin.y - (canvas.min.y + 400.0)).abs() < 1e-3, "{:?}", l.origin);
+    assert!(!l.occluders.is_empty(), "the floating cards are over the canvas");
+    assert!(l.occluders.iter().all(|r| canvas.contains_rect(*r) && r.is_positive()), "{:?}", l.occluders);
+}
