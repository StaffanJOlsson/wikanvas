+// Changed for Quire (embed feature): see patches/inkboard/README.md
+//! Cards of a hosted board (feature `embed`, see `embed.rs`): rectangles that embed one of the host page's documents
+//! (`BoxObj::embed`, `BoxObj::is_embed`). The host page draws the document inside the card, over the canvas, and edits it there; the
+//! engine keeps the card a box that is selected, moved, resized, copied and deleted like any other, and tells the host page:
+//!
+//! - after every frame in which any of it changed: the cards of the current page, the camera and the engine's own interface over the
+//!   canvas ([`EmbedLayout`], `HostEvents::embed_layout`), so that the host page can follow pans, zooms and gestures;
+//! - instead of editing a card's label: that its document should be opened (`HostEvents::embed_open`), never in a read-only host;
+//! - while the host page edits a card ([`App::set_embed_editing`]) the engine takes no key and shows no handle, and the first primary or
+//!   secondary press in the board, or the board taking the keyboard focus, ends that editing (`HostEvents::embed_edit_end`); a primary
+//!   press on the canvas then does nothing else, as the click that leaves a label's editing. The middle button still pans the board
+//!   without ending it.
+//!
+//! [`App::insert_embed`] adds a card, and [`App::set_embed_titles`] shows the documents' live titles as the cards' labels, in place:
+//! no undo step and no revision, and the next save keeps them. Coordinates for the host page are CSS pixels of the canvas element
+//! (egui points times the zoom factor); world units are the board's own. When the board is not hosted, a card is a plain rectangle
+//! whose label is edited as any other, and nothing here runs.
+
+use crate::app::App;
+use crate::render::Cam;
+use eframe::egui::{self, Pos2, pos2};
+use inkboard_core::num;
+use inkboard_core::{Color, Frame, Id, Kind, Object, RichText, Span, SpanStyle};
+use std::collections::HashMap;
+#[cfg(any(test, all(target_arch = "wasm32", feature = "embed")))]
+use {
+    crate::tools::Tool,
+    eframe::egui::vec2,
+    inkboard_core::model::Embed,
+    inkboard_core::{Align, BoxGeom, Dash, FontFamily, Label, Style},
+};
+
+/// Size of a new card, in world units.
+#[cfg(any(test, all(target_arch = "wasm32", feature = "embed")))]
+pub const CARD_SIZE: (f64, f64) = (480.0, 360.0);
+
+/// Style of a new card: a white sheet with a light gray border and a shadow.
+#[cfg(any(test, all(target_arch = "wasm32", feature = "embed")))]
+fn card_style() -> Style {
+    Style {
+        stroke: Color::rgb(0xc4, 0xca, 0xd4),
+        fill: Some(Color::rgb(0xff, 0xff, 0xff)),
+        width: 1.0,
+        dash: Dash::Solid,
+        opacity: 1.0,
+        roundness: 0.04,
+        shadow: true,
+    }
+}
+
+/// Style of a card's title: bold, dark ink whatever the background (the card is white).
+const TITLE_STYLE: SpanStyle =
+    SpanStyle { bold: true, italic: false, underline: false, strike: false, color: Some(Color::rgb(0x1d, 0x24, 0x30)), highlight: None };
+
+/// `text` as a card's title, in `style`.
+fn title_text(text: &str, style: SpanStyle) -> RichText {
+    if text.is_empty() { RichText::default() } else { RichText(vec![Span { text: text.to_owned(), style }]) }
+}
+
+/// The document a card embeds, `None` for any other object (an `embed` on another shape is not a card).
+pub fn card_item(o: &Object) -> Option<&str> {
+    match &o.kind {
+        Kind::Box(b) if b.is_embed() => b.embed.as_ref().map(|e| e.item.as_str()),
+        _ => None,
+    }
+}
+
+/// Why the host page's editing of a card ended in the engine.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum EditEnd {
+    /// A primary or secondary press in the board (its canvas or its interface).
+    Press,
+    /// The board took the keyboard focus (not by a press of the middle or an extra button).
+    Focus,
+    /// The card left the current page (deleted, hidden, another page or another board).
+    Gone,
+}
+
+impl EditEnd {
+    #[cfg_attr(not(all(target_arch = "wasm32", feature = "embed")), allow(dead_code, reason = "the embed feature's JS side reads it"))]
+    pub fn as_str(self) -> &'static str {
+        match self {
+            EditEnd::Press => "press",
+            EditEnd::Focus => "focus",
+            EditEnd::Gone => "gone",
+        }
+    }
+}
+
+/// A card of the current page, as drawn this frame.
+#[derive(Clone, Debug, PartialEq)]
+#[cfg_attr(not(all(target_arch = "wasm32", feature = "embed")), allow(dead_code, reason = "the embed feature's JS side reads it"))]
+pub struct EmbedBox {
+    pub id: Id,
+    /// `embed.item`, as stored.
+    pub item: String,
+    /// In world units; `angle` in radians about the frame's centre.
+    pub frame: Frame,
+    /// The label's plain text: the title the board stores.
+    pub label: String,
+    pub selected: bool,
+    /// The card or its layer is locked.
+    pub locked: bool,
+}
+
+/// Where the cards are: `screen = origin + world × zoom`, in CSS pixels of the canvas element.
+#[derive(Clone, Debug, PartialEq)]
+#[cfg_attr(not(all(target_arch = "wasm32", feature = "embed")), allow(dead_code, reason = "the embed feature's JS side reads it"))]
+pub struct EmbedLayout {
+    pub page: Id,
+    /// CSS pixels per world unit.
+    pub zoom: f32,
+    pub origin: Pos2,
+    /// The drawing area.
+    pub canvas: egui::Rect,
+    /// The engine's interface over the drawing area: every visible egui layer above the background (floating cards, menus, popups,
+    /// tooltips, toasts, windows), each cut to `canvas`.
+    pub occluders: Vec<egui::Rect>,
+    /// The cards of the current page on visible layers, in drawing order.
+    pub cards: Vec<EmbedBox>,
+    /// Every distinct `embed.item` of the board's cards (all pages and layers), sorted.
+    pub items: Vec<String>,
+    /// Every distinct `embed.item` of the cards on the engine's clipboard, sorted: a cut or copied card can still be pasted, on this
+    /// board or on the next one the host opens, so the host page keeps its document.
+    pub clipboard: Vec<String>,
+    /// The card the host page edits.
+    pub editing: Option<Id>,
+}
+
+/// A value rounded to 1/1000, as layouts are compared.
+fn milli(v: f64) -> i64 {
+    num::to_i64((v * 1000.0).round())
+}
+
+fn same_rect(a: egui::Rect, b: egui::Rect) -> bool {
+    [a.min.x, a.min.y, a.max.x, a.max.y].map(|v| milli(f64::from(v))) == [b.min.x, b.min.y, b.max.x, b.max.y].map(|v| milli(f64::from(v)))
+}
+
+fn same_card(a: &EmbedBox, b: &EmbedBox) -> bool {
+    let f = |f: &Frame| [f.x, f.y, f.w, f.h, f.angle].map(milli);
+    a.id == b.id && a.item == b.item && a.label == b.label && a.selected == b.selected && a.locked == b.locked && f(&a.frame) == f(&b.frame)
+}
+
+impl EmbedLayout {
+    /// The cards, the board's items, the clipboard's items and the editing state are the same.
+    fn same_cards(&self, other: &EmbedLayout) -> bool {
+        self.page == other.page
+            && self.items == other.items
+            && self.clipboard == other.clipboard
+            && self.editing == other.editing
+            && self.cards.len() == other.cards.len()
+            && self.cards.iter().zip(&other.cards).all(|(a, b)| same_card(a, b))
+    }
+
+    /// The camera, the drawing area and the interface over it are the same.
+    fn same_view(&self, other: &EmbedLayout) -> bool {
+        milli(f64::from(self.zoom)) == milli(f64::from(other.zoom))
+            && milli(f64::from(self.origin.x)) == milli(f64::from(other.origin.x))
+            && milli(f64::from(self.origin.y)) == milli(f64::from(other.origin.y))
+            && same_rect(self.canvas, other.canvas)
+            && self.occluders.len() == other.occluders.len()
+            && self.occluders.iter().zip(&other.occluders).all(|(a, b)| same_rect(*a, *b))
+    }
+
+    /// Is this layout news after `last` (the last one reported)? A page without cards, which had none either, does not report a change
+    /// of the camera or of the interface alone: nothing on it follows the camera.
+    fn worth_reporting(&self, last: &EmbedLayout) -> bool {
+        if !self.same_cards(last) {
+            return true;
+        }
+        let no_cards = self.cards.is_empty() && last.cards.is_empty();
+        if no_cards {
+            return false;
+        }
+        !self.same_view(last)
+    }
+}
+
+/// What a hosted board keeps about its cards (a part of `HostMode`).
+pub struct EmbedState {
+    /// The card the host page edits (`setEmbedEditing`).
+    pub editing: Option<Id>,
+    /// The documents' live titles, by `embed.item`.
+    titles: HashMap<String, String>,
+    /// The revision at which the titles were last applied (`None`: apply them on the next occasion).
+    titles_rev: Option<u64>,
+    /// The last layout reported.
+    last: Option<EmbedLayout>,
+    /// The next frame reports its layout whatever it holds (`requestEmbedLayout`, a new board).
+    force: bool,
+    /// The board's items and the revision they were collected at.
+    items: Option<(u64, Vec<String>)>,
+    /// Did the board have the keyboard focus on the last frame?
+    focused: bool,
+    /// The frame (egui's frame number) whose press ended the editing: its canvas press does nothing, in every pass of that frame.
+    swallow: Option<u64>,
+    /// The current frame, and the card opened in it: egui may run a frame twice, and the host page hears of a card once.
+    frame: u64,
+    opened: Option<(u64, Id)>,
+    /// CSS pixels per egui point, and the camera the canvas was drawn with on the last frame.
+    zoom_factor: f32,
+    cam: Option<Cam>,
+}
+
+impl Default for EmbedState {
+    fn default() -> Self {
+        Self {
+            editing: None,
+            titles: HashMap::new(),
+            titles_rev: None,
+            last: None,
+            force: true,
+            items: None,
+            focused: false,
+            swallow: None,
+            frame: 0,
+            opened: None,
+            zoom_factor: 1.0,
+            cam: None,
+        }
+    }
+}
+
+impl App {
+    /// The card the host page edits, while it does.
+    pub fn embed_editing(&self) -> Option<&Id> {
+        self.host.as_ref().and_then(|h| h.cards.editing.as_ref())
+    }
+
+    /// Is `id` a card of the current page, on a visible layer?
+    fn is_visible_card(&self, id: &Id) -> bool {
+        let page = self.ed.page();
+        page.get(id).is_some_and(|o| page.is_visible(o) && card_item(o).is_some())
+    }
+
+    /// Ends the host page's editing, telling it why.
+    fn end_embed_editing(&mut self, reason: EditEnd) {
+        let Some(h) = self.host.as_mut() else { return };
+        if let Some(id) = h.cards.editing.take() {
+            h.events.embed_edit_end(&id, reason);
+        }
+    }
+
+    /// Start of a hosted frame, before anything handles input: the host's editing ends on a primary press (whose canvas part is then
+    /// swallowed), on a secondary press (the context menu then opens as usual), or when the board takes the focus without a press; the
+    /// titles follow a revision change. The middle button (a pan) and the extra buttons leave the editing as it is, and so does the
+    /// focus their press brings to the board.
+    pub(crate) fn embed_frame_start(&mut self, ctx: &egui::Context) {
+        let Some(h) = self.host.as_mut() else { return };
+        let (primary, secondary, panning, focused) = ctx.input(|i| {
+            let p = &i.pointer;
+            let panning = [egui::PointerButton::Middle, egui::PointerButton::Extra1, egui::PointerButton::Extra2]
+                .into_iter()
+                .any(|b| p.button_down(b) || p.button_pressed(b) || p.button_released(b));
+            (p.button_pressed(egui::PointerButton::Primary), p.button_pressed(egui::PointerButton::Secondary), panning, i.focused)
+        });
+        let c = &mut h.cards;
+        c.frame = ctx.cumulative_frame_nr();
+        c.zoom_factor = ctx.zoom_factor();
+        let gained = focused && !c.focused;
+        c.focused = focused;
+        if c.editing.is_some() {
+            if primary || secondary {
+                if primary {
+                    c.swallow = Some(c.frame);
+                }
+                self.end_embed_editing(EditEnd::Press);
+            } else if gained && !panning {
+                self.end_embed_editing(EditEnd::Focus);
+            }
+        }
+        self.apply_embed_titles();
+    }
+
+    /// Does the canvas ignore this frame's press (the one that ended the host's editing)?
+    pub(crate) fn embed_swallows_press(&self, ctx: &egui::Context) -> bool {
+        self.host.as_ref().is_some_and(|h| h.cards.swallow == Some(ctx.cumulative_frame_nr()))
+    }
+
+    /// The camera the canvas is drawn with this frame (for the layout, and for points given by the host page).
+    pub(crate) fn embed_drawn(&mut self, cam: Cam) {
+        if let Some(h) = self.host.as_mut() {
+            h.cards.cam = Some(cam);
+        }
+    }
+
+    /// End of a hosted frame: the host's editing ends when its card left the page, the titles follow a revision change made during
+    /// the frame, and the layout goes to the host page when it changed (once per frame: not from a pass that egui throws away).
+    pub(crate) fn embed_frame_end(&mut self, ctx: &egui::Context) {
+        if self.host.is_none() {
+            return;
+        }
+        if self.embed_editing().is_some_and(|id| !self.is_visible_card(id)) {
+            self.end_embed_editing(EditEnd::Gone);
+        }
+        if self.apply_embed_titles() {
+            ctx.request_repaint();
+        }
+        if ctx.will_discard() {
+            return;
+        }
+        let Some(now) = self.embed_layout(ctx) else { return };
+        let Some(h) = self.host.as_mut() else { return };
+        let c = &mut h.cards;
+        if c.force || c.last.as_ref().is_none_or(|last| now.worth_reporting(last)) {
+            c.force = false;
+            h.events.embed_layout(&now);
+            c.last = Some(now);
+        }
+    }
+
+    /// The layout of this frame (`None` before the canvas was first drawn).
+    fn embed_layout(&mut self, ctx: &egui::Context) -> Option<EmbedLayout> {
+        let rev = self.ed.revision();
+        let h = self.host.as_mut()?;
+        let cam = h.cards.cam?;
+        if h.cards.items.as_ref().is_none_or(|(r, _)| *r != rev) {
+            let mut items: Vec<String> = self.ed.doc.pages.iter().flat_map(|p| &p.objects).filter_map(card_item).map(str::to_owned).collect();
+            items.sort_unstable();
+            items.dedup();
+            h.cards.items = Some((rev, items));
+        }
+        let items = h.cards.items.as_ref().map(|(_, items)| items.clone()).unwrap_or_default();
+        let mut clipboard: Vec<String> = self.clipboard.iter().filter_map(card_item).map(str::to_owned).collect();
+        clipboard.sort_unstable();
+        clipboard.dedup();
+        let zf = h.cards.zoom_factor;
+        let editing = h.cards.editing.clone();
+        let px = |r: egui::Rect| egui::Rect::from_min_max(pos2(r.min.x * zf, r.min.y * zf), pos2(r.max.x * zf, r.max.y * zf));
+        let canvas = self.canvas_rect;
+        let mut occluders: Vec<egui::Rect> = ctx.memory(|m| {
+            m.areas()
+                .visible_layer_ids()
+                .into_iter()
+                .filter(|l| l.order != egui::Order::Background)
+                .filter_map(|l| m.area_rect(l.id))
+                .map(|r| r.intersect(canvas))
+                .filter(egui::Rect::is_positive)
+                .map(px)
+                .collect()
+        });
+        // the layers come from a hash set: a fixed order, so that the same interface compares equal
+        occluders
+            .sort_by(|a, b| a.min.y.total_cmp(&b.min.y).then(a.min.x.total_cmp(&b.min.x)).then(a.max.y.total_cmp(&b.max.y)).then(a.max.x.total_cmp(&b.max.x)));
+        occluders.dedup();
+        let page = self.ed.page();
+        let cards = page
+            .objects
+            .iter()
+            .filter(|o| page.is_visible(o))
+            .filter_map(|o| {
+                let item = card_item(o)?;
+                let Kind::Box(b) = &o.kind else { return None };
+                Some(EmbedBox {
+                    id: o.id.clone(),
+                    item: item.to_owned(),
+                    frame: b.frame,
+                    label: b.label.text.to_plain(),
+                    selected: self.sel.contains(&o.id),
+                    locked: page.is_locked(o),
+                })
+            })
+            .collect();
+        Some(EmbedLayout {
+            page: page.id.clone(),
+            zoom: cam.zoom * zf,
+            origin: pos2(cam.origin.x * zf, cam.origin.y * zf),
+            canvas: px(canvas),
+            occluders,
+            cards,
+            items,
+            clipboard,
+            editing,
+        })
+    }
+
+    /// Instead of editing a card's label: asks the host page to open the card's document (`point`: where the double-click was, in egui
+    /// points). `false` when this is not a card of a hosted board, whose label is then edited as usual. A read-only host opens nothing.
+    pub(crate) fn open_embed(&mut self, id: &Id, point: Option<Pos2>) -> bool {
+        let Some(h) = self.host.as_mut() else { return false };
+        let Some(item) = self.ed.page().get(id).and_then(card_item) else { return false };
+        if h.read_only {
+            return true;
+        }
+        let c = &mut h.cards;
+        if c.opened.as_ref().is_some_and(|(frame, opened)| *frame == c.frame && opened == id) {
+            return true;
+        }
+        c.opened = Some((c.frame, id.clone()));
+        let zf = c.zoom_factor;
+        h.events.embed_open(id, item, point.map(|p| pos2(p.x * zf, p.y * zf)));
+        true
+    }
+
+    /// A new board in the host: its editing is gone, the titles were the previous board's, and the first frame reports its layout.
+    #[cfg(any(test, all(target_arch = "wasm32", feature = "embed")))]
+    pub(crate) fn embed_board_replaced(&mut self) {
+        self.end_embed_editing(EditEnd::Gone);
+        if let Some(h) = self.host.as_mut() {
+            let c = &mut h.cards;
+            c.titles.clear();
+            c.titles_rev = None;
+            c.items = None;
+            c.opened = None;
+            c.force = true;
+        }
+    }
+
+    /// Shows the live titles as the labels of the cards whose document has one, on every page: in place, so no undo step and no
+    /// revision (the next save keeps them). Once per revision, since an undo can bring an older label back. `true` when a label changed.
+    fn apply_embed_titles(&mut self) -> bool {
+        let rev = self.ed.revision();
+        let Some(h) = self.host.as_mut() else { return false };
+        let c = &mut h.cards;
+        if c.titles_rev == Some(rev) {
+            return false;
+        }
+        c.titles_rev = Some(rev);
+        let mut changed = false;
+        if c.titles.is_empty() {
+            return false;
+        }
+        for o in self.ed.doc.pages.iter_mut().flat_map(|p| p.objects.iter_mut()) {
+            let Kind::Box(b) = &mut o.kind else { continue };
+            if !b.is_embed() {
+                continue;
+            }
+            let Some(title) = b.embed.as_ref().and_then(|e| c.titles.get(&e.item)) else { continue };
+            if b.label.text.to_plain() != *title {
+                let style = b.label.text.0.first().map_or(TITLE_STYLE, |s| s.style);
+                b.label.text = title_text(title, style);
+                changed = true;
+            }
+        }
+        changed
+    }
+}
+
+/// The host page's calls (`embed.rs`).
+#[cfg(any(test, all(target_arch = "wasm32", feature = "embed")))]
+impl App {
+    /// The host page edits `id` (`None`: no card): the engine keeps it selected, shows no handle and takes no key until the editing
+    /// ends. An id that is not a card on a visible layer of the current page is ignored.
+    pub fn set_embed_editing(&mut self, id: Option<Id>) {
+        if self.host.is_none() || id.as_ref().is_some_and(|id| !self.is_visible_card(id)) {
+            return;
+        }
+        if let Some(id) = &id {
+            self.commit_editing();
+            self.sel = vec![id.clone()];
+        }
+        if let Some(h) = self.host.as_mut() {
+            h.cards.editing = id;
+        }
+    }
+
+    /// Adds a card for the document `item`, labelled `title`, centred on `at` (CSS pixels of the canvas; `None`: the centre of the
+    /// view), `w` × `h` world units when given and positive ([`CARD_SIZE`] otherwise), on the current page's first visible and unlocked
+    /// layer: one undo step, selected, with the select tool. `None` when the board is read-only (nothing changes).
+    pub fn insert_embed(&mut self, item: &str, title: &str, at: Option<Pos2>, w: Option<f64>, h: Option<f64>) -> Option<Id> {
+        // checked here: the editor drops a read-only change, but `Editor::insert` still returns an id
+        if self.view_only() {
+            return None;
+        }
+        self.commit_editing();
+        let size = |v: Option<f64>, default: f64| v.filter(|v| v.is_finite() && *v > 0.0).unwrap_or(default);
+        let (w, h) = (size(w, CARD_SIZE.0), size(h, CARD_SIZE.1));
+        let centre = match at {
+            None => self.view_center(),
+            Some(p) => {
+                let zf = self.host.as_ref().map_or(1.0, |h| h.cards.zoom_factor);
+                self.embed_cam().w(pos2(p.x / zf, p.y / zf))
+            }
+        };
+        let page = self.ed.page();
+        let layer = page.layers.iter().find(|l| l.visible && !l.locked).or(page.layers.first()).map(|l| l.id.clone());
+        let label = Label { text: title_text(title, TITLE_STYLE), family: FontFamily::Sans, size: 24.0, align: Align::Center };
+        let mut card = Object::new_box(BoxGeom::Rect, Frame::new(centre.x - w / 2.0, centre.y - h / 2.0, w, h), card_style(), label);
+        if let Kind::Box(b) = &mut card.kind {
+            b.embed = Some(Embed { item: item.to_owned() });
+        }
+        if let Some(layer) = layer {
+            card.layer = layer;
+        }
+        let id = self.ed.insert(card);
+        self.sel = vec![id.clone()];
+        self.tool = Tool::Select;
+        Some(id)
+    }
+
+    /// The camera of the last frame drawn (or the view's, before the first one).
+    fn embed_cam(&self) -> Cam {
+        self.host.as_ref().and_then(|h| h.cards.cam).unwrap_or_else(|| {
+            let v = self.ed.page().view;
+            Cam { origin: self.canvas_rect.min + vec2(num::f32(v.x), num::f32(v.y)), zoom: num::f32(v.zoom) }
+        })
+    }
+
+    /// Replaces the live titles (by `embed.item`) and shows them at once.
+    pub fn set_embed_titles(&mut self, titles: HashMap<String, String>) {
+        let Some(h) = self.host.as_mut() else { return };
+        h.cards.titles = titles;
+        h.cards.titles_rev = None;
+        self.apply_embed_titles();
+    }
+
+    /// The next frame reports its layout even when nothing changed.
+    pub fn request_embed_layout(&mut self) {
+        if let Some(h) = self.host.as_mut() {
+            h.cards.force = true;
+        }
+    }
+}
