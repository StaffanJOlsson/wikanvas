+fn wheel(t: &mut T, p: Pos2, modifiers: Modifiers) -> View {
+    t.mv(p);
+    let before = t.app().ed.page().view;
+    t.h.event(Event::MouseWheel { unit: egui::MouseWheelUnit::Point, delta: vec2(0.0, -120.0), modifiers });
+    t.h.step();
+    let after = t.app().ed.page().view;
+    View { x: after.x - before.x, y: after.y - before.y, zoom: after.zoom / before.zoom }
+}
+
+#[test]
+fn the_wheel_follows_its_own_modifiers() {
+    // in a web page the board learns the modifiers from key events on its canvas: while the host page has the keyboard focus (its
+    // editor), Shift and Alt are only on the wheel event itself
+    let (mut t, host) = editing_elsewhere();
+    let p = t.at(300.0, -300.0);
+    assert_eq!(t.h.input_mut().modifiers, Modifiers::NONE);
+    let shift = wheel(&mut t, p, Modifiers::SHIFT);
+    assert!(shift.x.abs() > 50.0 && shift.y.abs() < 1e-9 && (shift.zoom - 1.0).abs() < 1e-9, "Shift + wheel pans sideways: {shift:?}");
+    let alt = wheel(&mut t, p, Modifiers::ALT);
+    assert!(alt.y.abs() > 50.0 && alt.x.abs() < 1e-9 && (alt.zoom - 1.0).abs() < 1e-9, "Alt + wheel pans up and down: {alt:?}");
+    // the control: without a modifier the wheel zooms
+    let plain = wheel(&mut t, p, Modifiers::NONE);
+    assert!((plain.zoom - 1.0).abs() > 0.05, "the wheel zooms: {plain:?}");
+    assert_eq!(host.others(), [], "the host page's editing goes on");
+}
