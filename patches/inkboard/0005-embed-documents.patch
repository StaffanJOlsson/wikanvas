@@ -0,0 +1,717 @@
+// Changed for Quire (embed feature): see patches/inkboard/README.md
+//! Cards of a hosted board (`embed_cards.rs`) in a real egui cycle without a window, with the host page's events recorded: the
+//! layout, opening a card instead of editing its label, the host's editing, inserting a card, titles in place, no rotation handle, the
+//! wheel's own modifiers, the middle button's pan, the style panel and the cards on the clipboard.
+
+use crate::app::{HostEvents, HostMode};
+use crate::embed_cards::{EditEnd, EmbedLayout};
+use crate::tests::T;
+use crate::tools::Tool;
+use eframe::egui::{self, CursorIcon, Event, Key, Modifiers, PointerButton, Pos2, vec2};
+use inkboard_core::num;
+use inkboard_core::*;
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+
+/// Quire's shared fixture (`fixtures/boards/embed.inkboard`): two cards and a plain box.
+const FIXTURE: &str = r##"{"format":"inkboard","version":2,"document":{"name":"Embed test","background":{"preset":"white","pattern":"dots"},"pages":[{"id":"embedtest1","name":"Page 1","layers":[{"id":"main","name":"Layer 1","visible":true,"locked":false}],"objects":[{"id":"embedcard1","kind":{"type":"box","geom":"rect","frame":{"x":-520.0,"y":-200.0,"w":480.0,"h":360.0},"label":{"text":[{"text":"First page","bold":true,"color":"#1d2430"}],"family":"sans","size":24.0,"align":"center"},"embed":{"item":"0192f0e0-0000-7000-8000-000000000001"}},"style":{"stroke":"#c4cad4","fill":"#ffffff","width":1.0,"dash":"solid","opacity":1.0,"roundness":0.04,"shadow":true},"layer":"main"},{"id":"embedcard2","kind":{"type":"box","geom":"rect","frame":{"x":40.0,"y":-200.0,"w":480.0,"h":360.0},"label":{"text":[{"text":"Second page","bold":true,"color":"#1d2430"}],"family":"sans","size":24.0,"align":"center"},"embed":{"item":"0192f0e0-0000-7000-8000-000000000002"}},"style":{"stroke":"#c4cad4","fill":"#ffffff","width":1.0,"dash":"solid","opacity":1.0,"roundness":0.04,"shadow":true},"layer":"main"},{"id":"embedplain","kind":{"type":"box","geom":"rect","frame":{"x":-120.0,"y":220.0,"w":240.0,"h":120.0},"label":{"text":[{"text":"Plain box"}],"family":"sans","size":20.0,"align":"center"}},"style":{"stroke":"ink","fill":null,"width":3.0,"dash":"solid","opacity":1.0,"roundness":0.0},"layer":"main"}],"view":{"x":0.0,"y":0.0,"zoom":1.0}}],"assets":{}}}"##;
+const ITEM1: &str = "0192f0e0-0000-7000-8000-000000000001";
+const ITEM2: &str = "0192f0e0-0000-7000-8000-000000000002";
+
+#[derive(Clone, Debug, PartialEq)]
+enum Heard {
+    Changed(u64),
+    Layout(EmbedLayout),
+    Open(Id, String, Option<Pos2>),
+    End(Id, EditEnd),
+}
+
+/// The host page: records what it hears.
+#[derive(Clone, Default)]
+struct Host(Rc<RefCell<Vec<Heard>>>);
+
+impl HostEvents for Host {
+    fn ready(&self) {}
+    fn changed(&self, rev: u64) {
+        self.0.borrow_mut().push(Heard::Changed(rev));
+    }
+    fn save(&self) {}
+    fn embed_layout(&self, layout: &EmbedLayout) {
+        self.0.borrow_mut().push(Heard::Layout(layout.clone()));
+    }
+    fn embed_open(&self, id: &Id, item: &str, point: Option<Pos2>) {
+        self.0.borrow_mut().push(Heard::Open(id.clone(), item.to_owned(), point));
+    }
+    fn embed_edit_end(&self, id: &Id, reason: EditEnd) {
+        self.0.borrow_mut().push(Heard::End(id.clone(), reason));
+    }
+}
+
+impl Host {
+    fn take(&self) -> Vec<Heard> {
+        std::mem::take(&mut *self.0.borrow_mut())
+    }
+    fn layouts(&self) -> Vec<EmbedLayout> {
+        self.take().into_iter().filter_map(|h| if let Heard::Layout(l) = h { Some(l) } else { None }).collect()
+    }
+    fn others(&self) -> Vec<Heard> {
+        self.take().into_iter().filter(|h| !matches!(h, Heard::Layout(_))).collect()
+    }
+}
+
+/// A hosted board showing `board`, its view at scale 1 with the world origin at (600, 400) of the canvas, settled; nothing heard yet.
+fn hosted(board: &str, read_only: bool) -> (T, Host) {
+    let mut t = T::new();
+    let host = Host::default();
+    t.app().host = Some(HostMode::new(read_only, None, Box::new(host.clone())));
+    t.app().host_load(board).expect("the board loads");
+    t.app().ed.set_read_only(read_only);
+    t.app().fit_pending = false;
+    t.app().set_view(View { x: 600.0, y: 400.0, zoom: 1.0 });
+    settle(&mut t);
+    host.take();
+    (t, host)
+}
+
+/// Enough frames for the floating cards to settle.
+fn settle(t: &mut T) {
+    for _ in 0..6 {
+        t.h.step();
+    }
+}
+
+fn id(s: &str) -> Id {
+    Id::from(s)
+}
+
+fn label_of(t: &mut T, card: &str) -> String {
+    let Some(Kind::Box(b)) = t.app().ed.page().get(&id(card)).map(|o| o.kind.clone()) else { panic!("no box {card}") };
+    b.label.text.to_plain()
+}
+
+/// A double-click at the screen point `p`, with event times close enough for egui (each step advances its clock by 0.25 s), and
+/// far enough from any earlier click.
+fn double_click(t: &mut T, p: Pos2) {
+    t.mv(p);
+    let t0 = t.h.ctx.input(|i| i.time) + 1.0;
+    for (k, pressed) in [true, false, true, false].into_iter().enumerate() {
+        t.h.input_mut().time = Some(t0 + 0.05 * num::f64_of(k + 1));
+        t.button(p, pressed, Modifiers::NONE);
+    }
+    t.h.step();
+}
+
+fn click_screen(t: &mut T, p: Pos2) {
+    t.mv(p);
+    t.button(p, true, Modifiers::NONE);
+    t.button(p, false, Modifiers::NONE);
+}
