+#[test]
+fn embed_editing_ends_on_a_press_that_does_nothing_else() {
+    let (mut t, host) = hosted(FIXTURE, false);
+    t.app().set_embed_editing(Some(id("embedcard1")));
+    t.h.step();
+    assert_eq!(host.layouts().last().and_then(|l| l.editing.clone()), Some(id("embedcard1")));
+    assert_eq!(t.app().sel, [id("embedcard1")]);
+    let objects = t.objects().len();
+    // a press on empty canvas: reported once, and it neither deselects nor starts a marquee
+    let p = t.at(300.0, -300.0);
+    t.mv(p);
+    t.button(p, true, Modifiers::NONE);
+    assert!(t.app().drag.is_none(), "no marquee");
+    t.button(p, false, Modifiers::NONE);
+    settle(&mut t);
+    let heard = host.take();
+    let others: Vec<&Heard> = heard.iter().filter(|h| !matches!(h, Heard::Layout(_))).collect();
+    assert_eq!(others, [&Heard::End(id("embedcard1"), EditEnd::Press)]);
+    assert_eq!(t.app().sel, [id("embedcard1")], "the selection is unchanged");
+    assert_eq!(t.objects().len(), objects);
+    assert_eq!(t.app().embed_editing(), None);
+    // the layout follows the end: no editing any more, the card still selected
+    let end = heard.iter().position(|h| matches!(h, Heard::End(..))).unwrap();
+    let after: Vec<&EmbedLayout> = heard[end..].iter().filter_map(|h| if let Heard::Layout(l) = h { Some(l) } else { None }).collect();
+    assert!(matches!(after.as_slice(), [l] if l.editing.is_none() && l.cards[0].selected), "{heard:?}");
+    // the next press is an ordinary one again
+    click_screen(&mut t, p);
+    assert!(t.app().sel.is_empty());
+}
