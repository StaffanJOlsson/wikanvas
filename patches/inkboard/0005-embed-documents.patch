+/// The cards that embed the host page's documents (`embed_cards.rs`): `insertEmbed`, `setEmbedEditing`, `setEmbedTitles`,
+/// `requestEmbedLayout`.
+fn embed_methods(h: &Object, generation: u32) {
+    method(
+        h,
+        "insertEmbed",
+        Closure::<dyn Fn(JsValue) -> Result<JsValue, JsValue>>::new(move |a: JsValue| {
+            let item = get(&a, "item").as_string().ok_or_else(|| type_error("insertEmbed: `item` must be a string"))?;
+            let title = get(&a, "title").as_string().unwrap_or_default();
+            let at = get(&a, "at");
+            let at = if at.as_string().as_deref() == Some("center") {
+                None
+            } else {
+                let (x, y) = (get(&at, "x").as_f64(), get(&at, "y").as_f64());
+                match (x, y) {
+                    (Some(x), Some(y)) if x.is_finite() && y.is_finite() => Some(egui::pos2(inkboard_core::num::f32(x), inkboard_core::num::f32(y))),
+                    _ => return Err(type_error("insertEmbed: `at` must be 'center' or a point {x, y}")),
+                }
+            };
+            let (w, h) = (get(&a, "w").as_f64(), get(&a, "h").as_f64());
+            let id = with_app(generation, true, |app, _| app.insert_embed(&item, &title, at, w, h)).ok_or_else(not_mounted)?;
+            Ok(id.map_or(JsValue::NULL, |id| JsValue::from_str(id.as_str())))
+        }),
+    );
+    method(
+        h,
+        "setEmbedEditing",
+        Closure::<dyn Fn(JsValue)>::new(move |id: JsValue| {
+            let id = id.as_string().map(|id| inkboard_core::Id::from(id.as_str()));
+            with_app(generation, true, |app, _| app.set_embed_editing(id));
+        }),
+    );
+    method(
+        h,
+        "setEmbedTitles",
+        Closure::<dyn Fn(JsValue)>::new(move |titles: JsValue| {
+            let mut map = std::collections::HashMap::new();
+            if titles.is_object() {
+                for entry in Object::entries(titles.unchecked_ref()).iter() {
+                    let pair: js_sys::Array = entry.unchecked_into();
+                    if let (Some(item), Some(title)) = (pair.get(0).as_string(), pair.get(1).as_string()) {
+                        map.insert(item, title);
+                    }
+                }
+            }
+            with_app(generation, true, |app, _| app.set_embed_titles(map));
+        }),
+    );
+    method(
+        h,
+        "requestEmbedLayout",
+        Closure::<dyn Fn()>::new(move || {
+            with_app(generation, true, |app, _| app.request_embed_layout());
+        }),
+    );
+}
