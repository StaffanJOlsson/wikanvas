+    /// A card as Quire writes it: a rectangle whose box kind ends with `embed`.
+    const CARD: &str = r##"{"id":"card1","kind":{"type":"box","geom":"rect","frame":{"x":-240.0,"y":-180.0,"w":480.0,"h":360.0},"label":{"text":[{"text":"Meeting notes","bold":true,"color":"#1d2430"}],"family":"sans","size":24.0,"align":"center"},"embed":{"item":"0192f0e0-0000-7000-8000-000000000001"}},"style":{"stroke":"#c4cad4","fill":"#ffffff","width":1.0,"dash":"solid","opacity":1.0,"roundness":0.04,"shadow":true},"layer":"main"}"##;
+
+    fn box_of(o: &Object) -> &BoxObj {
+        let Kind::Box(b) = &o.kind else { panic!("not a box: {o:?}") };
+        b
+    }
+
+    /// `CARD` with its `embed` value replaced by `value` (JSON text).
+    fn card_with_embed(value: &str) -> String {
+        CARD.replace(r#"{"item":"0192f0e0-0000-7000-8000-000000000001"}"#, value)
+    }
+
+    #[test]
+    fn an_embedded_document_round_trips_byte_for_byte() {
+        let o: Object = serde_json::from_str(CARD).unwrap();
+        let b = box_of(&o);
+        assert_eq!(b.embed, Some(Embed { item: "0192f0e0-0000-7000-8000-000000000001".into() }));
+        assert!(b.is_embed());
+        assert_eq!(serde_json::to_string(&o).unwrap(), CARD);
+    }
+
+    #[test]
+    fn a_box_without_embed_serializes_exactly_as_before() {
+        let o = Object::new_box(BoxGeom::Rect, Frame::new(0.0, 0.0, 10.0, 10.0), Style::default(), Label::new("x", 20.0, Align::Center));
+        assert!(box_of(&o).embed.is_none() && !box_of(&o).is_embed());
+        let json = serde_json::to_string(&o).unwrap();
+        assert!(!json.contains("embed"), "{json}");
+        assert_eq!(serde_json::from_str::<Object>(&json).unwrap(), o);
+    }
+
+    #[test]
+    fn a_malformed_embed_loads_as_a_plain_box() {
+        for value in ["5", "{}", r#"{"item":3}"#, "null", r#""0192f0e0""#, "[]", r#"{"item":null}"#, r#"{"items":"a"}"#] {
+            let o: Object = serde_json::from_str(&card_with_embed(value)).unwrap_or_else(|e| panic!("{value}: {e}"));
+            assert_eq!(box_of(&o).embed, None, "{value}");
+            assert!(!box_of(&o).is_embed(), "{value}");
+            assert!(!serde_json::to_string(&o).unwrap().contains("embed"), "{value}: dropped on the next save");
+        }
+        // fields next to `item` are not kept
+        let o: Object = serde_json::from_str(&card_with_embed(r#"{"item":"a","size":3,"item2":"b"}"#)).unwrap();
+        assert_eq!(box_of(&o).embed, Some(Embed { item: "a".into() }));
+        let json = serde_json::to_string(&o).unwrap();
+        assert!(json.contains(r#""embed":{"item":"a"}},"style""#) && !json.contains("item2"), "{json}");
+    }
+
+    #[test]
+    fn an_embed_on_another_shape_is_kept_but_is_not_a_card() {
+        let json = CARD.replace(r#""geom":"rect""#, r#""geom":"ellipse""#);
+        let o: Object = serde_json::from_str(&json).unwrap();
+        assert!(box_of(&o).embed.is_some());
+        assert!(!box_of(&o).is_embed());
+        assert_eq!(serde_json::to_string(&o).unwrap(), json);
+    }
+
+    #[test]
+    fn a_board_with_cards_and_malformed_embeds_opens() {
+        let objects = [CARD.to_owned(), card_with_embed("5").replace("card1", "card2"), card_with_embed(r#"{"item":3}"#).replace("card1", "card3")];
+        let board = format!(
+            r#"{{"format":"inkboard","version":2,"document":{{"name":"Cards","pages":[{{"id":"p1","name":"Page 1","layers":[{{"id":"main","name":"Layer 1","visible":true,"locked":false}}],"objects":[{}]}}]}}}}"#,
+            objects.join(",")
+        );
+        let doc = crate::serial::from_json(&board).unwrap();
+        let cards: Vec<bool> = doc.pages[0].objects.iter().map(|o| box_of(o).is_embed()).collect();
+        assert_eq!(cards, [true, false, false]);
+    }
+
+    #[test]
+    fn a_box_kind_with_the_embed_key_twice_is_refused() {
+        // serde refuses a repeated known field before the lenient reader runs: the server refuses such a board too (it could not open)
+        let twice = CARD.replace(r#""embed":{"item""#, r#""embed":5,"embed":{"item""#);
+        assert!(serde_json::from_str::<Object>(&twice).is_err());
+    }
