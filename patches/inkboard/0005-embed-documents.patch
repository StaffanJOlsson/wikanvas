+#[test]
+fn the_middle_button_pans_without_ending_the_editing() {
+    let (mut t, host) = editing_elsewhere();
+    let p = t.at(300.0, -300.0);
+    t.mv(p);
+    let before = t.app().ed.page().view;
+    // the press, then the focus that the browser gives the board after it, while the button is down
+    t.h.event(Event::PointerButton { pos: p, button: PointerButton::Middle, pressed: true, modifiers: Modifiers::NONE });
+    t.h.step();
+    t.h.input_mut().focused = true;
+    t.h.event(Event::WindowFocused(true));
+    t.h.step();
+    for k in 1..=4 {
+        t.mv(p + vec2(20.0, 10.0) * num::f32(f64::from(k)));
+    }
+    let q = p + vec2(80.0, 40.0);
+    t.h.event(Event::PointerButton { pos: q, button: PointerButton::Middle, pressed: false, modifiers: Modifiers::NONE });
+    t.h.step();
+    settle(&mut t);
+    let v = t.app().ed.page().view;
+    assert!((v.x - before.x - 80.0).abs() < 1.0 && (v.y - before.y - 40.0).abs() < 1.0, "the middle drag panned: {before:?} → {v:?}");
+    assert_eq!(host.others(), [], "the editing goes on");
+    assert_eq!(t.app().embed_editing(), Some(&id("embedcard1")));
+    // a quick middle click whose release comes with the focus
+    t.h.input_mut().focused = false;
+    t.h.event(Event::WindowFocused(false));
+    t.h.step();
+    t.h.event(Event::PointerButton { pos: p, button: PointerButton::Middle, pressed: true, modifiers: Modifiers::NONE });
+    t.h.step();
+    let input = t.h.input_mut();
+    input.focused = true;
+    input.events.push(Event::WindowFocused(true));
+    input.events.push(Event::PointerButton { pos: p, button: PointerButton::Middle, pressed: false, modifiers: Modifiers::NONE });
+    t.h.step();
+    settle(&mut t);
+    assert_eq!(host.others(), []);
+    assert_eq!(t.app().embed_editing(), Some(&id("embedcard1")));
+    // a secondary press ends it (the context menu opens as usual)
+    t.h.event(Event::PointerButton { pos: p, button: PointerButton::Secondary, pressed: true, modifiers: Modifiers::NONE });
+    t.h.step();
+    t.h.event(Event::PointerButton { pos: p, button: PointerButton::Secondary, pressed: false, modifiers: Modifiers::NONE });
+    t.h.step();
+    assert_eq!(host.others(), [Heard::End(id("embedcard1"), EditEnd::Press)]);
+}
