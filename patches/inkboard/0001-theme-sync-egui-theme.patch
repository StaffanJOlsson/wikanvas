From: quire <quire@localhost>
Date: Wed, 28 Oct 2026 13:45:18 +0100
Subject: [PATCH 1/4] theme: sync egui theme

`theme::apply` sets the visuals of the current egui style only, but egui keeps
one style per theme and follows the system theme by default. When the OS
switches between light and dark, egui selects its other, default style and the
interface loses the board's visuals until the background changes again.

`apply` now fixes egui's theme to the one it styles. The test switches the
system theme after `apply` and checks that the applied visuals stay.
---
 crates/inkboard-app/src/theme.rs | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/crates/inkboard-app/src/theme.rs b/crates/inkboard-app/src/theme.rs
index eef3b5f..83392ba 100644
--- a/crates/inkboard-app/src/theme.rs
+++ b/crates/inkboard-app/src/theme.rs
@@ -1,3 +1,4 @@
+// Changed for Quire (embed feature): see patches/inkboard/README.md
 //! Interface theme: the colors, rounded corners, shadows and floating cards of the web prototype (light and dark).
 
 use crate::icons;
@@ -57,6 +58,9 @@ fn shadow(p: &Palette) -> Shadow {
 
 /// Applies the theme to the whole context (call again when the light/dark background changes).
 pub fn apply(ctx: &egui::Context, dark: bool) {
+    // egui keeps one style per theme and follows the system theme by default: without this, switching the OS between light and dark
+    // selects egui's other (default) style, which reverts these visuals until the board background changes again
+    ctx.set_theme(if dark { egui::Theme::Dark } else { egui::Theme::Light });
     let p = palette(dark);
     let mut v = if dark { egui::Visuals::dark() } else { egui::Visuals::light() };
     v.dark_mode = dark;
@@ -291,4 +295,18 @@ mod tests {
         assert_eq!(ctx.style().text_styles[&TextStyle::Body].size, 13.0);
         assert_eq!(ctx.style().visuals.window_corner_radius, CornerRadius::same(10));
     }
+
+    #[test]
+    fn a_system_theme_switch_keeps_the_applied_visuals() {
+        let ctx = egui::Context::default();
+        apply(&ctx, false);
+        // the OS switches to dark while the board stays light: the next frame must still use the light visuals applied above
+        let _ = ctx.run(egui::RawInput { system_theme: Some(egui::Theme::Dark), ..Default::default() }, |_| {});
+        assert!(!current(&ctx).dark);
+        assert_eq!(ctx.style().visuals.window_corner_radius, CornerRadius::same(10));
+        apply(&ctx, true);
+        let _ = ctx.run(egui::RawInput { system_theme: Some(egui::Theme::Light), ..Default::default() }, |_| {});
+        assert!(current(&ctx).dark);
+        assert_eq!(ctx.style().visuals.window_corner_radius, CornerRadius::same(10));
+    }
 }
