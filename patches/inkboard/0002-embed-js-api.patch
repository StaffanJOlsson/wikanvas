diff --git a/crates/inkboard-app/src/embed.rs b/crates/inkboard-app/src/embed.rs
new file mode 100644
index 0000000..cea5dc4
--- /dev/null
+++ b/crates/inkboard-app/src/embed.rs
@@ -0,0 +1,429 @@
+// Changed for Quire (embed feature): see patches/inkboard/README.md
+//! JS API of the `embed` feature, for a page that shows a board inside its own interface and owns the file: the wasm `main`
+//! installs `globalThis.inkboardEmbed` instead of starting the page of its own (`web.rs`). See `docs/WEB.md`, "Embedding".
+//!
+//! - `version` (the package version + `"+embed"`) and `formatVersion` (the native format version);
+//! - `mount(canvas, options)`: a promise of a handle (`snapshot`, `setBoard`, `revision`, `isDirty`, `markSaved`, `setTheme`,
+//!   `setReadOnly`, `setName`, `setActive`, `focus`, `fitView`, `destroy`). It rejects with `{kind, message}`: `webgl` (no WebGL 2),
+//!   `load` (the board cannot be read) or `start` (eframe could not start, or another board is mounted: one board per page, because
+//!   the browser side of `platform` keeps one application state).
+//!
+//! The workspace forbids unsafe code, so nothing is exported with `#[wasm_bindgen]`: the API is an object of closures, like the test
+//! hook of `web_test.rs`. Calls to the page's callbacks always go through `spawn_local`, because eframe holds the application while it
+//! builds a frame; the panic report goes through a plain timer of the page, which still fires after the wasm instance has trapped.
+
+use crate::app::{App, HostEvents, HostMode};
+use crate::{i18n, platform, web};
+use eframe::egui;
+use js_sys::{Function, Object, Promise, Reflect};
+use std::cell::{Cell, RefCell};
+use std::rc::Rc;
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::closure::WasmClosure;
+use wasm_bindgen::prelude::*;
+
+/// The board on the page.
+struct Mounted {
+    /// Which mount this is: a handle only drives the board it was made for.
+    generation: u32,
+    runner: eframe::WebRunner,
+    ctx: egui::Context,
+    canvas: web_sys::HtmlCanvasElement,
+}
+
+thread_local! {
+    /// A board is mounted, or being mounted.
+    static MOUNTED: Cell<bool> = const { Cell::new(false) };
+    static CURRENT: RefCell<Option<Mounted>> = const { RefCell::new(None) };
+    static GENERATION: Cell<u32> = const { Cell::new(0) };
+    /// `onError` of the mounted board, for the panic hook.
+    static ON_ERROR: RefCell<Option<Function>> = const { RefCell::new(None) };
+    static PANIC_HOOK: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Puts `inkboardEmbed` on the global object (the wasm `main` of the `embed` build).
+pub fn install_global() {
+    eframe::WebLogger::init(log::LevelFilter::Error).ok();
+    let api = Object::new();
+    set(&api, "version", &JsValue::from_str(concat!(env!("CARGO_PKG_VERSION"), "+embed")));
+    set(&api, "formatVersion", &JsValue::from(inkboard_core::serial::VERSION));
+    method(&api, "mount", Closure::<dyn Fn(JsValue, JsValue) -> Promise>::new(|canvas, options: JsValue| mount(canvas, &options)));
+    let _ = Object::freeze(&api);
+    set(&js_sys::global(), "inkboardEmbed", &api);
+}
+
+/* ------------------------------------------------------------------------------------------------------------------- mount */
+
+/// What `mount` reads from its options (unknown or missing values: today's behaviour of the page of its own).
+struct MountOptions {
+    board: Option<String>,
+    name: Option<String>,
+    dark: Option<bool>,
+    lang: Option<i18n::Lang>,
+    read_only: bool,
+    events: JsEvents,
+    on_error: Option<Function>,
+}
+
+impl MountOptions {
+    fn read(o: &JsValue) -> Result<Self, JsValue> {
+        let board = get(o, "board");
+        let board = if board.is_null() || board.is_undefined() {
+            None
+        } else {
+            Some(board.as_string().ok_or_else(|| error("load", "`board` must be the board's JSON text, or null"))?)
+        };
+        let lang = match get(o, "lang").as_string().as_deref() {
+            Some("en") => Some(i18n::Lang::En),
+            Some("fr") => Some(i18n::Lang::Fr),
+            _ => None,
+        };
+        Ok(Self {
+            board,
+            name: get(o, "name").as_string(),
+            dark: theme_of(&get(o, "theme")),
+            lang,
+            read_only: get(o, "readOnly").is_truthy(),
+            events: JsEvents { ready: function(o, "onReady"), change: function(o, "onChange"), save: function(o, "onSave") },
+            on_error: function(o, "onError"),
+        })
+    }
+}
+
+fn mount(canvas: JsValue, options: &JsValue) -> Promise {
+    if MOUNTED.get() {
+        return Promise::reject(&error("start", "already mounted"));
+    }
+    let Ok(canvas) = canvas.dyn_into::<web_sys::HtmlCanvasElement>() else {
+        return Promise::reject(&error("start", "mount needs a canvas element"));
+    };
+    let opts = match MountOptions::read(options) {
+        Ok(o) => o,
+        Err(e) => return Promise::reject(&e),
+    };
+    let Some(document) = web_sys::window().and_then(|w| w.document()) else {
+        return Promise::reject(&error("start", "no document"));
+    };
+    if cfg!(not(feature = "web-wgpu")) && !web::webgl_available(&document) {
+        return Promise::reject(&error("webgl", "WebGL 2 is not available"));
+    }
+    // the ids come from a clock natively; a browser has none, and two browsers must never draw the same ids
+    inkboard_core::model::seed_ids(platform::random_seed());
+    let doc = match opts.board.as_deref().map(inkboard_core::serial::from_json) {
+        Some(Ok(doc)) => doc,
+        Some(Err(e)) => return Promise::reject(&error("load", &e.to_string())),
+        None => inkboard_core::Document::default(),
+    };
+    MOUNTED.set(true);
+    let generation = GENERATION.get().wrapping_add(1);
+    GENERATION.set(generation);
+    ON_ERROR.with(|e| e.borrow_mut().clone_from(&opts.on_error));
+    wasm_bindgen_futures::future_to_promise(async move {
+        let runner = eframe::WebRunner::new();
+        // after eframe's own hook (installed by `WebRunner::new`), which it then calls first
+        install_panic_hook();
+        let slot: Rc<RefCell<Option<egui::Context>>> = Rc::default();
+        let creator_slot = Rc::clone(&slot);
+        let MountOptions { name, dark, lang, read_only, events, .. } = opts;
+        let started = runner
+            .start(
+                canvas.clone(),
+                eframe::WebOptions::default(),
+                Box::new(move |cc| {
+                    platform::init_ctx(&cc.egui_ctx);
+                    let mut app = App::new(cc, None, None);
+                    app.host = Some(HostMode { read_only, dark, paused: false, events: Box::new(events), last_key: (0, 0), ready_sent: false });
+                    if let Some(lang) = lang {
+                        i18n::set(lang);
+                    }
+                    app.host_load_doc(doc);
+                    app.ed.set_read_only(read_only);
+                    if let Some(name) = name {
+                        app.ed.doc.name = name;
+                    }
+                    *creator_slot.borrow_mut() = Some(cc.egui_ctx.clone());
+                    Ok(Box::new(app))
+                }),
+            )
+            .await;
+        let ctx = slot.borrow_mut().take();
+        match (started, ctx) {
+            (Ok(()), Some(ctx)) => {
+                CURRENT.with(|c| *c.borrow_mut() = Some(Mounted { generation, runner, ctx, canvas }));
+                Ok(handle(generation))
+            }
+            (started, _) => {
+                runner.destroy();
+                platform::clear_ctx();
+                ON_ERROR.with(|e| e.borrow_mut().take());
+                MOUNTED.set(false);
+                let message = started.err().map_or_else(|| "the application was not created".to_owned(), |e| message_of(&e));
+                Err(error("start", &message))
+            }
+        }
+    })
+}
+
+/* ------------------------------------------------------------------------------------------------------------------ handle */
+
+/// The handle `mount` resolves to. Once `destroy` was called (or another board was mounted after it) it does nothing: `snapshot`
+/// and `setBoard` throw `{kind: 'start'}`, `revision` is 0 and `isDirty` false.
+fn handle(generation: u32) -> JsValue {
+    let h = Object::new();
+    board_methods(&h, generation);
+    view_methods(&h, generation);
+    method(&h, "destroy", Closure::<dyn Fn()>::new(move || destroy(generation)));
+    let _ = Object::freeze(&h);
+    h.into()
+}
+
+/// The board itself: `snapshot`, `setBoard`, `revision`, `isDirty`, `markSaved`.
+fn board_methods(h: &Object, generation: u32) {
+    method(
+        h,
+        "snapshot",
+        Closure::<dyn Fn() -> Result<JsValue, JsValue>>::new(move || {
+            with_app(generation, false, |app, _| {
+                let o = Object::new();
+                set(&o, "board", &JsValue::from_str(&app.host_snapshot()));
+                set(&o, "revision", &js_number(app.ed.revision()));
+                JsValue::from(o)
+            })
+            .ok_or_else(not_mounted)
+        }),
+    );
+    method(
+        h,
+        "setBoard",
+        Closure::<dyn Fn(JsValue, JsValue) -> Result<(), JsValue>>::new(move |board: JsValue, name: JsValue| {
+            // read before anything changes: a board that cannot be read leaves the current one as it is
+            let doc = if board.is_null() || board.is_undefined() {
+                inkboard_core::Document::default()
+            } else {
+                let json = board.as_string().ok_or_else(|| error("load", "the board must be its JSON text, or null"))?;
+                inkboard_core::serial::from_json(&json).map_err(|e| error("load", &e.to_string()))?
+            };
+            with_app(generation, true, |app, _| {
+                app.host_load_doc(doc);
+                if let Some(name) = name.as_string() {
+                    app.ed.doc.name = name;
+                }
+            })
+            .ok_or_else(not_mounted)
+        }),
+    );
+    method(h, "revision", Closure::<dyn Fn() -> JsValue>::new(move || js_number(with_app(generation, false, |app, _| app.ed.revision()).unwrap_or(0))));
+    method(h, "isDirty", Closure::<dyn Fn() -> bool>::new(move || with_app(generation, false, |app, _| app.dirty()).unwrap_or(false)));
+    method(
+        h,
+        "markSaved",
+        Closure::<dyn Fn(JsValue)>::new(move |rev: JsValue| {
+            let Some(rev) = rev.as_f64() else { return };
+            with_app(generation, true, |app, _| app.saved_rev = inkboard_core::num::to_u64(rev));
+        }),
+    );
+}
+
+/// How the board is shown: `setTheme`, `setReadOnly`, `setName`, `setActive`, `focus`, `fitView`.
+fn view_methods(h: &Object, generation: u32) {
+    method(
+        h,
+        "setTheme",
+        Closure::<dyn Fn(JsValue)>::new(move |theme: JsValue| {
+            with_app(generation, true, |app, _| {
+                if let Some(host) = app.host.as_mut() {
+                    host.dark = theme_of(&theme);
+                }
+            });
+        }),
+    );
+    method(
+        h,
+        "setReadOnly",
+        Closure::<dyn Fn(JsValue)>::new(move |on: JsValue| {
+            let on = on.is_truthy();
+            with_app(generation, true, |app, _| {
+                if on {
+                    // the text typed so far stays, while the editor still accepts it
+                    app.commit_editing();
+                }
+                if let Some(host) = app.host.as_mut() {
+                    host.read_only = on;
+                }
+                app.ed.set_read_only(on);
+            });
+        }),
+    );
+    method(
+        h,
+        "setName",
+        Closure::<dyn Fn(JsValue)>::new(move |name: JsValue| {
+            let Some(name) = name.as_string() else { return };
+            // the name only names the exported files: no undo step, no revision
+            with_app(generation, true, |app, _| app.ed.doc.name = name);
+        }),
+    );
+    method(
+        h,
+        "setActive",
+        Closure::<dyn Fn(JsValue)>::new(move |on: JsValue| {
+            let on = on.is_truthy();
+            // active again: a frame now; inactive: no frame is asked for at all
+            with_app(generation, on, |app, _| {
+                if let Some(host) = app.host.as_mut() {
+                    host.paused = !on;
+                }
+            });
+        }),
+    );
+    method(
+        h,
+        "focus",
+        Closure::<dyn Fn()>::new(move || {
+            with_app(generation, true, |_, m| m.canvas.focus().ok());
+        }),
+    );
+    method(
+        h,
+        "fitView",
+        Closure::<dyn Fn()>::new(move || {
+            with_app(generation, true, |app, _| app.fit_pending = true);
+        }),
+    );
+}
+
+/// Runs `f` on the board of `generation` and, with `repaint`, asks for a frame. `None` when that board is gone (destroyed, or the
+/// engine stopped after a panic).
+fn with_app<R>(generation: u32, repaint: bool, f: impl FnOnce(&mut App, &Mounted) -> R) -> Option<R> {
+    CURRENT.with(|c| {
+        let c = c.borrow();
+        let m = c.as_ref().filter(|m| m.generation == generation)?;
+        let r = {
+            let mut app = m.runner.app_mut::<App>()?;
+            f(&mut app, m)
+        };
+        if repaint {
+            m.ctx.request_repaint();
+        }
+        Some(r)
+    })
+}
+
+fn destroy(generation: u32) {
+    let gone = CURRENT.with(|c| {
+        let mut c = c.borrow_mut();
+        if c.as_ref().is_some_and(|m| m.generation == generation) { c.take() } else { None }
+    });
+    if let Some(m) = gone {
+        m.runner.destroy();
+        platform::clear_ctx();
+        ON_ERROR.with(|e| e.borrow_mut().take());
+        MOUNTED.set(false);
+    }
+}
+
+/* ------------------------------------------------------------------------------------------------------------- page events */
+
+/// The page's callbacks of one mount.
+struct JsEvents {
+    ready: Option<Function>,
+    change: Option<Function>,
+    save: Option<Function>,
+}
+
+impl HostEvents for JsEvents {
+    fn ready(&self) {
+        later(self.ready.as_ref(), JsValue::UNDEFINED);
+    }
+
+    fn changed(&self, rev: u64) {
+        let e = Object::new();
+        set(&e, "revision", &js_number(rev));
+        later(self.change.as_ref(), e.into());
+    }
+
+    fn save(&self) {
+        later(self.save.as_ref(), JsValue::UNDEFINED);
+    }
+}
+
+/// Calls `f(arg)` once the current frame is over (eframe holds the application while it builds one, so a callback that calls the
+/// handle would find it taken).
+fn later(f: Option<&Function>, arg: JsValue) {
+    let Some(f) = f.cloned() else { return };
+    wasm_bindgen_futures::spawn_local(async move {
+        if let Err(e) = f.call1(&JsValue::NULL, &arg) {
+            web_sys::console::error_1(&e);
+        }
+    });
+}
+
+/// Reports a panic to the page's `onError` (`{kind: 'panic', message}`), chained after the hooks already installed.
+fn install_panic_hook() {
+    if PANIC_HOOK.replace(true) {
+        return;
+    }
+    let previous = std::panic::take_hook();
+    std::panic::set_hook(Box::new(move |info| {
+        previous(info);
+        report_panic(&info.to_string());
+    }));
+}
+
+fn report_panic(message: &str) {
+    let Some(f) = ON_ERROR.with(|e| e.try_borrow().ok().and_then(|e| e.clone())) else { return };
+    let Some(window) = web_sys::window() else { return };
+    // a timer of the page, not `spawn_local`: the wasm instance traps right after this hook, and its tasks never run again
+    let call: Function = f.bind1(&JsValue::NULL, &error("panic", message)).unchecked_into();
+    let _ = window.set_timeout_with_callback_and_timeout_and_arguments_0(&call, 0);
+}
+
+/* ---------------------------------------------------------------------------------------------------------------- helpers */
+
+fn set(o: &JsValue, key: &str, value: &JsValue) {
+    let _ = Reflect::set(o, &JsValue::from_str(key), value);
+}
+
+fn get(o: &JsValue, key: &str) -> JsValue {
+    if o.is_object() { Reflect::get(o, &JsValue::from_str(key)).unwrap_or(JsValue::UNDEFINED) } else { JsValue::UNDEFINED }
+}
+
+fn function(o: &JsValue, key: &str) -> Option<Function> {
+    get(o, key).dyn_into::<Function>().ok()
+}
+
+/// Puts a closure on `o` for good (a few bytes per mount).
+fn method<T: ?Sized + WasmClosure>(o: &Object, name: &str, f: Closure<T>) {
+    set(o, name, f.as_ref());
+    f.forget();
+}
+
+/// `'light'` → light, `'dark'` → dark, anything else (`'board'`, missing): the board background decides.
+fn theme_of(theme: &JsValue) -> Option<bool> {
+    match theme.as_string().as_deref() {
+        Some("light") => Some(false),
+        Some("dark") => Some(true),
+        _ => None,
+    }
+}
+
+/// `{kind, message}`, what the API rejects with and throws.
+fn error(kind: &str, message: &str) -> JsValue {
+    let o = Object::new();
+    set(&o, "kind", &JsValue::from_str(kind));
+    set(&o, "message", &JsValue::from_str(message));
+    o.into()
+}
+
+fn not_mounted() -> JsValue {
+    error("start", "the board is not mounted (destroyed, or the engine stopped)")
+}
+
+fn message_of(e: &JsValue) -> String {
+    e.dyn_ref::<js_sys::Error>().map_or_else(|| e.as_string().unwrap_or_else(|| format!("{e:?}")), |err| String::from(err.message()))
+}
+
+#[expect(clippy::cast_precision_loss, reason = "a revision counts edits: it stays far below 2^53")]
+fn js_number(n: u64) -> JsValue {
+    JsValue::from_f64(n as f64)
+}
