+    /// The text being typed, as far as it is not yet part of the board (0 when nothing is pending): a change of it is a change for
+    /// the host page, which saves what [`App::host_snapshot`] returns.
+    fn pending_text_key(&self) -> u64 {
+        use std::hash::{Hash as _, Hasher as _};
+        let Some(e) = self.editing.as_ref().filter(|_| self.editing_pending()) else { return 0 };
+        let mut h = std::hash::DefaultHasher::new();
+        (&e.id, &e.buf, format!("{:?}", e.align)).hash(&mut h);
+        h.finish() | 1
+    }
+
+    /// A read-only host page: like a read-only guest, the board can only be looked at and pointed at.
+    fn host_guard(&mut self) {
+        if !self.host.as_ref().is_some_and(|h| h.read_only) {
+            return;
+        }
+        if !matches!(self.tool, Tool::Hand | Tool::Laser) {
