+    /// Tells the host page that the first frame is drawn, and about a change of the board or of the text being typed: at most once
+    /// per frame, and never in the middle of a gesture (the board is only consistent once it ends).
+    fn host_frame(&mut self) {
+        if self.host.is_none() {
+            return;
+        }
+        let key = (self.ed.revision(), self.pending_text_key());
+        let settled = !self.objects_moving() && self.drag.is_none();
+        let Some(h) = self.host.as_mut() else { return };
+        if !h.ready_sent {
+            h.ready_sent = true;
+            h.events.ready();
+        }
+        if settled && key != h.last_key {
+            h.last_key = key;
+            h.events.changed(key.0);
+        }
+    }
