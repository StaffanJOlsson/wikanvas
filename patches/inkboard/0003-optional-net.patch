diff --git a/crates/inkboard-app/Cargo.toml b/crates/inkboard-app/Cargo.toml
index df30aa4..9454e40 100644
--- a/crates/inkboard-app/Cargo.toml
+++ b/crates/inkboard-app/Cargo.toml
@@ -12,11 +12,15 @@ name = "inkboard"
 path = "src/main.rs"
 
 [features]
+# The network of shared sessions (`inkboard-net`, iroh). The desktop always needs it; a web build without it (`--no-default-features`)
+# cannot join a session and is smaller (an embedded board, feature `embed`, usually has no use for it).
+default = ["net"]
+net = ["dep:inkboard-net"]
 # Web renderers (wasm32 only; the desktop build is unaffected). eframe compiles ONE painter for the web: `glow` wins if both are on.
 web-glow = ["eframe/glow"]
 web-wgpu = ["eframe/wgpu", "dep:wgpu"]
 # Test hook `window.__inkboard_test` of the browser end-to-end bench (web/test/e2e.mjs); never in the published page.
-web-test = []
+web-test = ["net"]
 # JS API for pages that embed the board (`globalThis.inkboardEmbed`, docs/WEB.md "Embedding"; wasm32 only): the wasm `main`
 # installs it instead of starting the page of its own.
 embed = []
@@ -31,7 +35,7 @@ inkboard-pen = { path = "../inkboard-pen" }
 inkboard-formats = { path = "../inkboard-formats" }
 inkboard-icons = { path = "../inkboard-icons" }
 inkboard-session = { path = "../inkboard-session" }
-inkboard-net = { path = "../inkboard-net" }
+inkboard-net = { path = "../inkboard-net", optional = true }
 
 # Desktop only: system clipboard, window handle, MCP server (live mode, data folder), system language, the embedded icon pack (the web
 # build fetches it on demand).
