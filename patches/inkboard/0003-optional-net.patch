diff --git a/crates/inkboard-app/src/session_net_off.rs b/crates/inkboard-app/src/session_net_off.rs
new file mode 100644
index 0000000..a6a5d7b
--- /dev/null
+++ b/crates/inkboard-app/src/session_net_off.rs
@@ -0,0 +1,33 @@
+// Changed for Quire (embed feature): see patches/inkboard/README.md
+//! Web build without the `net` feature: no network for shared sessions. Nothing installs a guest factory (`web.rs`), the menu does
+//! not offer "Join a session…", and `platform` refuses every relay address. The "Join" window and the shutdown still call the small
+//! settings functions below, which `session_net_web.rs` has too.
+
+use std::path::Path;
+use std::time::Duration;
+
+/// A custom relay list that cannot be used (never built: the list is always empty).
+#[derive(Debug)]
+pub struct RelayListError;
+
+impl RelayListError {
+    #[expect(clippy::unused_self, reason = "the shape of the native error")]
+    pub fn message(&self) -> String {
+        String::new()
+    }
+}
+
+/// There is no network to use a relay list with: it is always empty.
+#[expect(clippy::unnecessary_wraps, reason = "the signature of the native function")]
+pub fn parse_relay_list(_text: &str) -> Result<Vec<String>, RelayListError> {
+    Ok(Vec::new())
+}
+
+pub fn read_relays_text(_dir: &Path) -> String {
+    String::new()
+}
+
+pub fn save_relays_to(_dir: &Path, _urls: &[String]) {}
+
+/// There are no background closings to wait for.
+pub fn wait_background_closes(_max: Duration) {}
