+/// Every relay address is refused without the `net` feature.
+#[cfg(not(feature = "net"))]
+pub fn check_relay_url(_url: &str, _allow_private: bool) -> Result<NoRelayUrl, NoNetwork> {
+    Err(NoNetwork)
+}
+
+/// No relay is known without the `net` feature.
+#[cfg(not(feature = "net"))]
+pub fn is_known_relay(_url: &str, _configured: &[String]) -> bool {
+    false
+}
