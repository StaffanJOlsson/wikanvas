 pub use inkboard_net::config::{check_relay_url, is_known_relay};
 
+/// Without the `net` feature no relay address is acceptable (nothing could connect to it): see `session_net_off.rs`.
+#[cfg(not(feature = "net"))]
+#[derive(Debug)]
+pub struct NoRelayUrl;
+
+#[cfg(not(feature = "net"))]
+impl NoRelayUrl {
+    #[expect(clippy::unused_self, reason = "the shape of the network crate's relay URL")]
